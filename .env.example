# PTT Insight config — copy to .env and adjust

# Web server
ADDR=:8088

# Database (crawler's PostgreSQL)
# Local dev: use the DB container IP (run: docker inspect ptt-db-1 --format '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}')
# Docker:    postgres://ptt:ptt@db:5432/ptt?sslmode=disable  (joins ptt_default network)
DATABASE_URL=postgres://ptt:ptt@172.19.0.2:5432/ptt?sslmode=disable

# LLM (OpenAI-compatible endpoint)
# Local dev via opencode proxy:
LLM_BASE_URL=http://127.0.0.1:18905
# Production (Z.AI coding plan, credits with off-peak 50%):
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
# LLM_API_KEY=your_zai_api_key
LLM_API_KEY=
LLM_MODEL=glm-5.2

# Fallback for Z.AI content-filtered articles (gambling/politics/adult)
# via opencode proxy (no content filter; only works from host, not Docker)
FALLBACK_LLM_BASE_URL=http://127.0.0.1:18905
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gpt-5.6-luna
# Or direct OpenAI:
# FALLBACK_LLM_BASE_URL=https://api.openai.com/v1
# FALLBACK_LLM_API_KEY=your_openai_api_key
# FALLBACK_LLM_MODEL=gpt-5-mini

# Insight worker
RUN_WORKER=1
WORKER_BATCH=10
# Only analyze articles with net_count >= this (has discussion value)
WORKER_MIN_NET=20
# WORKER_INTERVAL=5m   # set to schedule batches; 0 = continuous
# Off-peak: skip Z.AI peak hours (Mon-Fri 14:00-18:00 UTC+8) for 50% credit discount
# 1 = avoid peak (default), 0 = always run
WORKER_OFFPEAK=1
PAGE_SIZE=30
